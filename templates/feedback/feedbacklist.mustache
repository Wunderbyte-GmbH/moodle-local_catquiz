{{!
    @template local_catquiz
    Template which defines a quiz attempt feedback.
    Classes required for JS:
    * none
    Data attributes required for JS:
    * none
    Context variables required for this template:
    Example context (json):
    {
      "header": "Attempt 1",
      "feedback": {
        "studentfeedback": [
            {
                "heading": "Student Feedback 1",
                "content": "This is the content of student feedback 1."
            }
        ],
        "teacherfeedback": [
            {
                "heading": "Teacher Feedback 1",
                "content": "This is the content of teacher feedback 1."
            }
        ]
      }
    }
}}
    <div class="card">
      <div class="card-header" id="local-catquiz-attempts-{{uniqid}}-{{attemptid}}-heading">
        <h5 class="mb-0">
          <button class="btn btn-link {{^active}}collapsed{{/active}}" data-toggle="collapse" data-target="#local-catquiz-attempts-{{uniqid}}-{{attemptid}}" aria-expanded="{{^active}}false{{/active}}{{#active}}true{{/active}}" aria-controls="local-catquiz-attempts-{{uniqid}}-{{attemptid}}">
            {{header}}
          </button>
        </h5>
      </div>

      <div id="local-catquiz-attempts-{{uniqid}}-{{attemptid}}" class="collapse {{#active}}show{{/active}}" aria-labelledby="local-catquiz-attempts-{{uniqid}}-{{attemptid}}-heading" data-parent="#local-catquiz-attempts-{{uniqid}}">
        <div class="card-body">
            {{#lazy}}
            {{! Issue #85: the header only; the feedback is loaded when the attempt is opened. }}
            <div data-region="local_catquiz-lazyfeedback" data-attemptid="{{attemptid}}"
                 data-generatorname="attempt" data-audience="student"></div>
            {{/lazy}}
            {{^lazy}}
            {{> local_catquiz/attemptfeedback}}
            {{/lazy}}
        </div>
      </div>
    </div>
