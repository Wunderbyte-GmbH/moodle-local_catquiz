{{!
    @template local_catquiz/catscaleshortcodes/statisticschart

    One chart of the statistics shortcode (issues #85, #88).

    Lazy: an empty region that local_catquiz/statistics fills through local_catquiz_render_statistics_chart
    when the tab holding it is shown. Otherwise the chart itself.

    Example context (json):
    {
        "chartname": "attemptspertimerange",
        "charttitle": "Number of attempts",
        "chart": "<div>...chart...</div>",
        "colorbarlegend": false
    }
}}
<div class="local-catquiz-statistics-chart mb-3" data-chartname="{{chartname}}">
{{#lazy}}
    <div data-region="local_catquiz-lazystatistics" data-chart="{{chartname}}" data-scope="{{scope}}"></div>
{{/lazy}}
{{^lazy}}
    {{#charttitle}}<h5>{{charttitle}}</h5>{{/charttitle}}
    <div>{{{chart}}}</div>
    {{#colorbarlegend}}
        <div class="catquiz-legend">
            <h5>{{#str}}feedbackbarlegend, local_catquiz{{/str}}</h5>
            {{#feedbackbarlegend}}
                <div>
                    <span class="catquiz-legend-symbol" style="background: {{subcolorcode}};"></span>
                    <span class="catquiz-legend-description">{{subfeedbacktext}}</span>
                    <span class="catquiz-legend-range">{{subfeedbackrange}}</span>
                </div>
            {{/feedbackbarlegend}}
        </div>
    {{/colorbarlegend}}
{{/lazy}}
</div>
