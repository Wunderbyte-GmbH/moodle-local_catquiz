{{!
    @template local_catquiz
    Template which defines a entities view page.
    Classes required for JS:
    * none
    Data attributes required for JS:
    * none
    Context variables required for this template:
    Example context (json):
    {
        "heading": {"title": "Statistics", "description": "Course 1"},
        "abilityprofilechart": {"chartname": "abilityprofile", "charttitle": "Profile", "chart": "<div>...chart...</div>"},
        "learningprogress": {"chartname": "learningprogress", "lazy": true, "scope": "{}"}
    }
}}
{{#error}}
    {{error}}
{{/error}}
{{^error}}


    {{! Issue #30: tabs and panels are paired by ids of this render, so the same shortcode twice on one
        page keeps its tabs apart; role, aria-controls, aria-selected and aria-labelledby per the ARIA
        tabs pattern. Bootstrap 4 markup on purpose - this line runs on Moodle 4.5. }}
    {{#heading}}
        <h4>{{{title}}}</h4>
        <p style="margin-bottom: 1em">{{{description}}}</p>
        <!-- Nav tabs -->
        <ul style="list-style: outside none none; margin-bottom: 1em;" class="nav nav-tabs" role="tablist">
          <li class="nav-item" role="presentation">
            <a class="nav-link active" id="local-catquiz-statistics-{{uniqid}}-overview-tab" data-toggle="tab" href="#local-catquiz-statistics-{{uniqid}}-overview"
               role="tab" aria-controls="local-catquiz-statistics-{{uniqid}}-overview" aria-selected="true">{{#str}}catquizstatistics_overview, local_catquiz{{/str}}</a>
          </li>
          <li class="nav-item" role="presentation">
            <a class="nav-link" id="local-catquiz-statistics-{{uniqid}}-testusage-tab" data-toggle="tab" href="#local-catquiz-statistics-{{uniqid}}-testusage"
               role="tab" aria-controls="local-catquiz-statistics-{{uniqid}}-testusage" aria-selected="false">{{#str}}catquizstatistics_testusage, local_catquiz{{/str}}</a>
          </li>
          <li class="nav-item" role="presentation">
            <a class="nav-link" id="local-catquiz-statistics-{{uniqid}}-learningprogress-tab" data-toggle="tab" href="#local-catquiz-statistics-{{uniqid}}-learningprogress"
               role="tab" aria-controls="local-catquiz-statistics-{{uniqid}}-learningprogress" aria-selected="false">{{#str}}learningprogresstitle, local_catquiz{{/str}}</a>
          </li>
          {{#exportbutton}}
          <li class="nav-item" role="presentation">
            <a class="nav-link" id="local-catquiz-statistics-{{uniqid}}-export-tab" data-toggle="tab" href="#local-catquiz-statistics-{{uniqid}}-export"
               role="tab" aria-controls="local-catquiz-statistics-{{uniqid}}-export" aria-selected="false">Export</a>
          </li>
          {{/exportbutton}}
        </ul>
    {{/heading}}
        <!-- Tab panes -->
        {{! Issue #85: each chart is its own region; with lazy loading it is built when its tab is shown. }}
        <div class="tab-content local-catquiz-statistics" data-region="local_catquiz-statistics">
          <div class="tab-pane active" id="local-catquiz-statistics-{{uniqid}}-overview" role="tabpanel"
               {{#heading}}aria-labelledby="local-catquiz-statistics-{{uniqid}}-overview-tab"{{/heading}} tabindex="0">
            {{#abilityprofilechart}}
                {{> local_catquiz/catscaleshortcodes/statisticschart }}
            {{/abilityprofilechart}}
            {{#detectedscales}}
                {{> local_catquiz/catscaleshortcodes/statisticschart }}
            {{/detectedscales}}
          </div>
          <div class="tab-pane" id="local-catquiz-statistics-{{uniqid}}-testusage" role="tabpanel"
               {{#heading}}aria-labelledby="local-catquiz-statistics-{{uniqid}}-testusage-tab"{{/heading}} tabindex="0">
            {{#attemptspertimerangechart}}
                {{> local_catquiz/catscaleshortcodes/statisticschart }}
            {{/attemptspertimerangechart}}
            {{#attemptsperpersonchart}}
                {{> local_catquiz/catscaleshortcodes/statisticschart }}
            {{/attemptsperpersonchart}}
          </div>
          <div class="tab-pane" id="local-catquiz-statistics-{{uniqid}}-learningprogress" role="tabpanel"
               {{#heading}}aria-labelledby="local-catquiz-statistics-{{uniqid}}-learningprogress-tab"{{/heading}} tabindex="0">
            {{#learningprogress}}
                {{> local_catquiz/catscaleshortcodes/statisticschart }}
            {{/learningprogress}}
          </div>
          {{#exportbutton}}
          <div class="tab-pane" id="local-catquiz-statistics-{{uniqid}}-export" role="tabpanel"
               {{#heading}}aria-labelledby="local-catquiz-statistics-{{uniqid}}-export-tab"{{/heading}} tabindex="0">
            <h5 style="margin-top: 1em; margin-bottom: 0;">{{#str}}catquizstatistics_exportcsv_heading, local_catquiz{{/str}}</h5>
            <div>{{#str}}catquizstatistics_exportcsv_description, local_catquiz{{/str}}</div>
            <div style="display: flex; align-items: center; flex-direction: column;" class="flex-wrapper">
                {{{ exportbutton }}}
            </div>
          </div>
          {{/exportbutton}}
        </div>
{{/error}}
{{#js}}
    require(['local_catquiz/statistics'], function(statistics) {
        statistics.init();
    });
{{/js}}
