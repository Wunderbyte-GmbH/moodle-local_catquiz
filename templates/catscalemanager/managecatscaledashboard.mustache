{{!
    @template local_catquiz
    Template which defines a catquiz view page.
    Classes required for JS:
    * none
    Data attributes required for JS:
    * none
    Context variables required for this template:
    Example context (json):
    {
      "summaryheading": "Summary Heading",
      "testitemsimporter": "Test Items Importer Content"
    }
}}

<h1>{{summaryheading}}</h1>

<ul class="nav nav-tabs" id="myTab">
  <li class="nav-item">
    <a class="nav-link {{#issummary}}active{{/issummary}}" id="summary-tab" href="{{summaryurl}}" {{#issummary}}aria-current="page"{{/issummary}}>{{#str}}summary, local_catquiz{{/str}}</a>
  </li>
  <li class="nav-item">
    <a class="nav-link {{#iscatscales}}active{{/iscatscales}}" id="catscales-tab" href="{{catscalesurl}}" {{#iscatscales}}aria-current="page"{{/iscatscales}}>{{#str}} catscalesheading, local_catquiz{{/str}}</a>
  </li>
  <li class="nav-item">
    <a class="nav-link {{#isquestions}}active{{/isquestions}}" id="questions-tab" href="{{questionsurl}}" {{#isquestions}}aria-current="page"{{/isquestions}}>{{#str}}questions, local_catquiz{{/str}}</a>
  </li>
  <li class="nav-item">
    <a class="nav-link {{#istestsandtemplates}}active{{/istestsandtemplates}}" id="testsandtemplates-tab" href="{{testsandtemplatesurl}}" {{#istestsandtemplates}}aria-current="page"{{/istestsandtemplates}}>{{#str}}testsandtemplates, local_catquiz{{/str}}</a>
  </li>
  <li class="nav-item">
    <a class="nav-link {{#isquizattempts}}active{{/isquizattempts}}" id="quizattempts-tab" href="{{quizattemptsurl}}" {{#isquizattempts}}aria-current="page"{{/isquizattempts}}>{{#str}}quizattempts, local_catquiz{{/str}}</a>
  </li>
  <li class="nav-item">
    <a class="nav-link {{#iscalculations}}active{{/iscalculations}}" id="calculations-tab" href="{{calculationsurl}}" {{#iscalculations}}aria-current="page"{{/iscalculations}}>{{#str}}calculations, local_catquiz{{/str}}</a>
  </li>
  <li class="nav-item">
    <a class="nav-link {{#isversioning}}active{{/isversioning}}" id="versioning-tab" href="{{versioningurl}}" {{#isversioning}}aria-current="page"{{/isversioning}}>{{#str}}versioning, local_catquiz{{/str}}</a>
  </li>
  <li class="nav-item">
    <a class="nav-link {{#isimporter}}active{{/isimporter}}" id="importer-tab" href="{{importerurl}}" {{#isimporter}}aria-current="page"{{/isimporter}}>{{#str}} import, core{{/str}}</a>
  </li>
</ul>

<div class="tab-content" id="myTabContent">
  {{#issummary}}
  <div class="tab-pane fade show active" id="lcq_summary">
    {{> local_catquiz/catscalemanager/summary}}
  </div>
{{/issummary}}
  {{#iscatscales}}
  <div class="tab-pane fade show active" id="lcq_catscales">
    {{> local_catquiz/catscalemanager/catscales}}
  </div>
{{/iscatscales}}
  {{#isquestions}}
  <div class="tab-pane fade show active" id="lcq_questions">
    {{> local_catquiz/catscalemanager/questions/questionsdisplay}}
  </div>
{{/isquestions}}
  {{#istestsandtemplates}}
  <div class="tab-pane fade show active" id="lcq_testsandtemplates">
    {{> local_catquiz/catscalemanager/testsandtemplates/testsandtemplatesdisplay}}
  </div>
{{/istestsandtemplates}}
  {{#isquizattempts}}
  <div class="tab-pane fade show active" id="lcq_quizattempts">
    {{> local_catquiz/catscalemanager/quizattempts/quizattemptsdisplay}}
  </div>
{{/isquizattempts}}
  {{#iscalculations}}
  <div class="tab-pane fade show active" id="lcq_calculations">
    {{> local_catquiz/catscalemanager/calculations/calculationsdisplay}}
  </div>
{{/iscalculations}}
  {{#isversioning}}
  <div class="tab-pane fade show active" id="lcq_versioning">
    {{> local_catquiz/catcontextdashboard}}
  </div>
{{/isversioning}}
  {{#isimporter}}
  <div class="tab-pane fade show active" id="lcq_importer">
    {{{testitemsimporter}}}
    {{>local_catquiz/importer/importerdatainfodisplay}}
  </div>
{{/isimporter}}
</div>

{{#js}}
    {{! Issue #29: only the active tab is rendered, so a module whose elements live on
        another tab finds nothing. csvimport builds a dynamic form from the container
        it queries; with a null container it throws, and a thrown module leaves the
        page permanently "not ready" - which is how Behat scenarios started failing at
        an unrelated step. It is loaded only where its form exists. }}
    {{#isimporter}}
    require(['local_catquiz/csvimport'], function(init) {
      init.init();
    });
    {{/isimporter}}
    {{! The context selector sits above the tabs and is present on every one. }}
    require(['local_catquiz/scaleandcontextselector'], function(init) {
      init.init();
    });
{{/js}}
