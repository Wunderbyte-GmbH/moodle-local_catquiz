# Enforce LF line endings for all text files.
* text=auto eol=lf

# Files and directories that must not be part of a distributed release archive
# (git archive / export). Runtime code, language strings, templates, PHPUnit and
# Behat tests, and the changelog are kept; development-only tooling and internal
# session documentation are excluded.
/.github/                 export-ignore
/doc/                     export-ignore
/erpnext.yml              export-ignore
# Werkzeuge fuer Betrieb und Support werden ausgeliefert (u. a. cli/revalidate_attempts.php,
# cli/export_trace.php, cli/diagnose_*.php). Nur Entwicklungs-, Last- und Experimentskripte nicht.
/cli/compare_runs.php              export-ignore
/cli/compare_versions.php          export-ignore
/cli/edgecase_emit_fixtures.php    export-ignore
/cli/edgecase_experiment.php       export-ignore
/cli/edgecase_lib.php              export-ignore
/cli/explain_hotqueries.php        export-ignore
/cli/explain_seed.php              export-ignore
/cli/loadtest_seed.php             export-ignore
/cli/measure_ability_fit.php       export-ignore
/cli/measure_attempt.php           export-ignore
/cli/measure_feedback_cache.php    export-ignore
/cli/measure_runtime_pool.php      export-ignore
/cli/measure_screens.php           export-ignore
/cli/measure_session_pool.php      export-ignore
/cli/reproduce_issue_64.php        export-ignore
/cli/verify_recalculation_lock.php export-ignore
package.json              export-ignore
babel.config.js           export-ignore

# Verhindert, dass die Submodule-Ordner im ZIP-Export landen
catquizcentralhub/host/   export-ignore
catquizcentralhub/client/ export-ignore

# Schließt auch Git-Konfigurationsdateien aus dem ZIP aus
.gitmodules               export-ignore
.gitignore                export-ignore
.gitattributes            export-ignore
/Makefile export-ignore
